{
    "name": "apiverve/passwordstrength",
    "description": "Password Strength is a password strength checker API that scores how strong a password is. It returns a strength label and score, a breakdown of the character types used, weak-pattern detection, theoretical entropy in bits, and recommendations to improve it.",
    "version": "1.2.3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "passwordstrength",
        "password strength api",
        "password strength checker api",
        "signup password check api",
        "password strength checker",
        "check password strength"
    ],
    "homepage": "https://apiverve.com/marketplace/passwordstrength?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/passwordstrength",
        "source": "https://github.com/apiverve/passwordstrength-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Passwordstrength\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Passwordstrength\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
